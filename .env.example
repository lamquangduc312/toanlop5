# Sao chép file này thành ".env.local" rồi điền cấu hình Firebase (Firebase Console > Project settings > Your apps > Web app).
# Nếu để trống, ứng dụng vẫn chạy và lưu kết quả vào trình duyệt (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
